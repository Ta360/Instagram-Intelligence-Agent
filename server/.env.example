# ─── Server ────────────────────────────────────────────────────────────────
API_PORT=4200
NODE_ENV=development
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5373

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
# Local dev: `npm run dev` starts an embedded PostgreSQL at this URL automatically.
DATABASE_URL=postgresql://iia:iia_local_dev@localhost:5433/instagram_intel

# ─── Instagram / Meta ──────────────────────────────────────────────────────
# mock       → realistic DEMO DATA, no Instagram calls (default when credentials are missing)
# production → Instagram Graph API (Business Discovery) using the credentials below
INSTAGRAM_API_MODE=mock
# Long-lived access token for the Facebook Page linked to your Instagram Business/Creator account.
# Needs: instagram_basic, instagram_manage_insights, pages_show_list, pages_read_engagement, business_management
INSTAGRAM_ACCESS_TOKEN=
# Numeric Instagram User ID of YOUR Business/Creator account (the account that performs discovery)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
# Used server-side only to sign requests (appsecret_proof). Never sent to the browser.
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v26.0
# Media items requested per profile fetch (keep small to save API quota)
INSTAGRAM_MEDIA_LIMIT=24
# Outbound call budget enforced by this server (Graph API default is ~200 calls / user / hour)
INSTAGRAM_MAX_CALLS_PER_HOUR=150
# Profile responses are cached for this many seconds
PROFILE_CACHE_TTL_SECONDS=300
# Minimum live-tracking interval (minutes) allowed in production mode
MIN_REFRESH_INTERVAL_MINUTES=15

# ─── AI Assistant (optional) ───────────────────────────────────────────────
# Without a key the assistant uses a built-in command parser that calls the same backend tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Dashboard accounts (sign in required) ─────────────────────────────────
# The FIRST account can always sign up (it becomes the owner). After that sign-up is closed
# unless ALLOW_SIGNUP=true. Sessions use an HMAC-signed HttpOnly cookie.
ALLOW_SIGNUP=false
# Optional: only this email may create the FIRST account (set it for any public deployment).
OWNER_EMAIL=
# Required in production: a random string of at least 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string
